# ============================================
# Hishabi AI — Backend Environment Variables
# ============================================
# Copy this file to `.env` and fill in real values.
# Never commit `.env` — it is gitignored.
#
# WARNING: SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security.
# Keep it server-side only. Never expose to frontend or commit it.
# ============================================

# --- Supabase ---
# Find these in: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJI...your-service-role-key

# --- Server config ---
PORT=8003
HOST=127.0.0.1
ENVIRONMENT=development
# Options: development, staging, production

# --- CORS allowed origins (comma-separated) ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- LLM (Gemini) ---
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash-exp

# --- Meta / Facebook (for Messenger + Instagram webhooks) ---
# Create app at: https://developers.facebook.com
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_WEBHOOK_VERIFY_TOKEN=generate-a-random-string-here
META_GRAPH_API_VERSION=v21.0

# --- WhatsApp Business Cloud API ---
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-id
WHATSAPP_ACCESS_TOKEN=your-whatsapp-token

# --- SSLCommerz (payment gateway) ---
# Sandbox: https://developer.sslcommerz.com
SSLCOMMERZ_STORE_ID=your-store-id
SSLCOMMERZ_STORE_PASSWORD=your-store-password
SSLCOMMERZ_SANDBOX=true
# Set to false in production

# --- Courier APIs (add as partnerships activate) ---
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_BASE_URL=https://api-hermes.pathao.com

REDX_API_TOKEN=
REDX_BASE_URL=https://openapi.redx.com.bd

STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
STEADFAST_BASE_URL=https://portal.packzy.com/api/v1

# --- Encryption (for storing access tokens in DB) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
TOKEN_ENCRYPTION_KEY=generate-a-strong-32-byte-key

# --- Optional: monitoring ---
SENTRY_DSN=
LOGTAIL_TOKEN=
