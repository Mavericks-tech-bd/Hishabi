# ============================================
# Hishabi AI — Frontend Environment Variables
# ============================================
# Copy this file to `.env.local` and fill in real values.
# Never commit `.env.local` — it is gitignored.
#
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# Never put secrets in NEXT_PUBLIC_ variables.
# ============================================

# --- Supabase (public, safe for browser) ---
# Find these in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# --- Backend API URL ---
# Local dev: http://127.0.0.1:8003
# Production: https://api.hishabi.ai
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8003

# --- App metadata (optional) ---
NEXT_PUBLIC_APP_NAME=Hishabi AI
NEXT_PUBLIC_APP_URL=http://localhost:3000
